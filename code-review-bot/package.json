{
  "name": "tilde-code-review-bot-example",
  "version": "1.0.0",
  "description": "Production-oriented GitHub pull request review agent built with Tilde, Modal, Next.js, and the Vercel AI SDK.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "onlyBuiltDependencies": [
      "cbor-extract",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/mcp": "1.0.59",
    "@ai-sdk/openai": "3.0.81",
    "ai": "6.0.220",
    "modal": "0.9.0",
    "next": "16.2.12",
    "nice-grpc": "2.1.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tilde-harness-sdk": "git+https://github.com/trytilde/harness-sdk.git#a1868803df1ea4283e74f88424024635d5a58d88",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
