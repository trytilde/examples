{
  "name": "tilde-code-review-bot-example",
  "version": "1.0.0",
  "description": "Production-oriented GitHub pull request review agent built with Tilde, Modal, Next.js, and the Vercel AI SDK.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "onlyBuiltDependencies": [
      "cbor-extract",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "1.0.66",
    "@ai-sdk/openai": "3.0.90",
    "@trytilde/harness-sdk": "0.1.2",
    "@trytilde/harness-sdk-vercel-ai-node": "0.2.0",
    "ai": "6.0.238",
    "modal": "0.9.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "string-argv": "0.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  }
}
